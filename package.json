{
  "name": "react-notifications-cascade",
  "version": "2.1.0",
  "description": "A flexible notification system with multiple action buttons, configurable duration, and backwards compatibility built with React and Material UI",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js && node -e \"require('fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "dev": "rollup -c -w",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@emotion/react": ">=11.0.0",
    "@emotion/styled": ">=11.0.0",
    "@mui/icons-material": ">=5.0.0",
    "@mui/material": ">=5.0.0",
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup": "^4.67.4",
    "rollup-plugin-peer-deps-external": "^2.2.4"
  },
  "resolutions": {
    "browserslist": "^4.29.5",
    "picomatch": "^4.0.7"
  },
  "keywords": [
    "react",
    "notifications",
    "material-ui",
    "toast",
    "alerts",
    "action-buttons",
